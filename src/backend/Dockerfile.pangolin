# Build UShER for use with pangolin 4+
# bookworm (glibc 2.36) is required: UShER binaries now require GLIBC_2.33+ at
# runtime, which bullseye (glibc 2.31) cannot satisfy.
FROM debian:bookworm AS usher
ENV APT_KEY_DONT_WARN_ON_DANGEROUS_USAGE=DontWarn
ENV DEBIAN_FRONTEND=noninteractive
USER root
RUN apt-get update && apt-get install -yq --no-install-recommends \
    git wget \
    ca-certificates \
    sudo python3 python3-pip
RUN mkdir -p /usherbuild
WORKDIR /usherbuild
# faSomeRecords and faSize are needed for the UShER WDL workflow
RUN wget http://hgdownload.soe.ucsc.edu/admin/exe/linux.x86_64/faSomeRecords
RUN wget http://hgdownload.soe.ucsc.edu/admin/exe/linux.x86_64/faSize
RUN chmod 775 *
# v0.6.4 and v0.6.5 are excluded by pangolin (known broken, see cov-lineages/pangolin#560).
# v0.6.3 is the last safe version for pangolin 4.3.x + pangolin-data 1.40.
RUN git clone https://github.com/yatisht/usher.git
RUN cd usher && git checkout v0.6.3 && ./install/installUbuntu.sh

FROM python:3.10-slim-bookworm AS base
ENV FLASK_APP=aspen.main
EXPOSE 3000

# Install poetry
RUN apt update && apt install -y libdigest-sha-perl wget
ENV POETRY_VERSION=1.3.2
RUN python3 -m pip install poetry==$POETRY_VERSION

WORKDIR /usr/src/app

# boost, tbb, mpi, and isal are runtime deps for the usher binaries.
RUN apt-get update && apt-get install -y  \
        make wget git jq gcc unzip curl bzip2 \
        libboost-filesystem1.74.0 \
        libboost-program-options1.74.0 \
        libboost-iostreams1.74.0 \
        libboost-date-time1.74.0 \
        libprotobuf32 \
        libtbb12 \
        libopenmpi3 \
        libisal2

# Install DB certs.
ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /usr/local/share/ca-certificates/global-bundle.crt
RUN update-ca-certificates

# Install Pangolin and PangoLEARN + deps (for ncov)
# The cov-lineages projects aren't available on PyPI, so install via git URLs.
RUN pip3 install snakemake==7.30.1
# required to fix broken snakemake dependency, see this link: https://github.com/snakemake/snakemake/issues/2607,
# snakemake moved away from pulp in 8.1.2 but we would need to upgrade python in order to use that version
# for now pinning pulp to 2.7.0 works
RUN pip3 install pulp==2.7.0
RUN pip3 install git+https://github.com/cov-lineages/pangolin.git@v4.3.4
RUN pip3 install git+https://github.com/cov-lineages/pangolin-data.git@v1.40
RUN pip3 install git+https://github.com/cov-lineages/scorpio.git@v0.3.19
RUN pip3 install git+https://github.com/cov-lineages/constellations.git@v0.1.12

# libtbb soname changed from .so.2 (bullseye/TBB 2020) to .so.12 (bookworm/oneTBB 2021).
# libtbb12 on bookworm does not include libtbb_preview.so.12 so create that symlink.
# libtbb_preview.so.2 is the TBB 2020.3 preview lib compiled from source by UShER's
# CMake FetchContent at tbb_cmake_build/tbb_cmake_build_subdir_release/. We copy it
# directly rather than symlinking to libtbb_preview.so.12 (oneTBB 2021.x) because
# oneTBB removed tbb::task — required by usher-sampled — causing a symbol lookup error.
RUN ln -s /usr/lib/x86_64-linux-gnu/libtbb.so.12 /usr/lib/x86_64-linux-gnu/libtbb_preview.so.12

# Download gofasta and minimap2 for Pangolin
RUN curl -fsSL https://github.com/virus-evolution/gofasta/releases/download/v1.2.0/gofasta-linux-amd64 \
 -o /usr/local/bin/gofasta && chmod a+x /usr/local/bin/gofasta
RUN curl -fsSL https://github.com/lh3/minimap2/releases/download/v2.24/minimap2-2.24_x64-linux.tar.bz2 \
  | tar xjvpf - --no-same-owner --strip-components=1 -C /usr/local/bin minimap2-2.24_x64-linux/minimap2 \
  && chmod a+x /usr/local/bin/gofasta

COPY --from=usher \
    /usherbuild/usher/build/compareVCF \
    /usherbuild/usher/build/faToVcf \
    /usherbuild/usher/build/matOptimize \
    /usherbuild/usher/build/matUtils \
    /usherbuild/usher/build/ripples \
    /usherbuild/usher/build/ripples-fast \
    /usherbuild/usher/build/ripplesInit \
    /usherbuild/usher/build/ripplesUtils \
    /usherbuild/usher/build/transpose_vcf \
    /usherbuild/usher/build/transposed_vcf_print_name \
    /usherbuild/usher/build/transposed_vcf_to_fa \
    /usherbuild/usher/build/transposed_vcf_to_vcf \
    /usherbuild/usher/build/usher \
    /usherbuild/usher/build/usher-sampled \
    /usr/local/bin

# Copy TBB 2020.3 libtbb_preview.so.2 built by UShER's CMake FetchContent.
# This provides tbb::task (removed in oneTBB 2021.x) which usher-sampled requires.
COPY --from=usher \
    /usherbuild/usher/build/tbb_cmake_build/tbb_cmake_build_subdir_release/libtbb_preview.so.2 \
    /usr/lib/x86_64-linux-gnu/libtbb_preview.so.2
RUN ldconfig

# Fail the build if pangolin cannot start or if the lineage data does not carry
# the clades we pinned this version for. PQ.16.1.1 and its alias SV are absent
# from pangolin-data 1.38, which made UShER fall back to the sibling PQ.17.
RUN pangolin -pv
RUN python3 - <<'PY'
import json, pathlib, pangolin_data
data = pathlib.Path(pangolin_data.__file__).parent / "data"
aliases = json.loads((data / "alias_key.json").read_text())
assert aliases.get("SV") == "XDV.1.5.1.1.8.1.16.1.1", aliases.get("SV")
designated = {line.split(",")[1] for line in (data / "lineages.hash.csv").read_text().splitlines()[1:]}
for lineage in ("PQ.16.1.1", "SV.1", "SV.2"):
    assert lineage in designated, lineage
print(f"pangolin-data {pangolin_data.__version__} lineage data verified")
PY

# Poetry: install app
COPY pyproject.toml poetry.lock environment.yaml ./
COPY third-party ./third-party
RUN wget https://github.com/chanzuckerberg/oso/archive/czge-oso25.zip -O oso.zip && \
    unzip -q oso.zip && \
    mv oso-czge-oso25/languages/python/sqlalchemy-oso sqlalchemy-oso && rm oso.zip
RUN poetry config virtualenvs.create false && \
    poetry install
ENV PYTHONPATH=.

COPY . .
# Install the aspen package
RUN poetry install
